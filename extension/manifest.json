{
  "manifest_version": 3,
  "name": "ScamShield AI — Pre-Click Search & Maps Guard",
  "version": "1.0.0",
  "description": "Displays real-time SAFE / FRAUD warning badges on Google Search and Google Maps links before you click.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamShield AI Guard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.ae/*",
        "https://maps.google.com/*",
        "https://www.bing.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

