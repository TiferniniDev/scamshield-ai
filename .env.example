# ScamShield AI Configuration
# Copy this file to .env and fill in your Telegram Bot Token

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Free Gemini API key from https://aistudio.google.com/apikey (adds Layer-3 AI reasoning)
GEMINI_API_KEY=your_free_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
API_HOST=127.0.0.1
API_PORT=8000
DNS_PORT=1053
BLOCK_PAGE_IP=127.0.0.1

